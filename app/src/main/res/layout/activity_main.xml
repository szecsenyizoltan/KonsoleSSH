<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/terminal_bg">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/toolbar_bg"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/toolbar_bg"
            app:contentInsetStart="12dp"
            app:contentInsetStartWithNavigation="0dp"
            app:title=""
            app:titleTextColor="@color/text_primary">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@mipmap/ic_launcher"
                    android:contentDescription="@string/app_name" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/app_name"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </androidx.appcompat.widget.Toolbar>

        <!-- Tab bar row: TabLayout + "+" button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/tab_bg">

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayout"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                app:tabMode="scrollable"
                app:tabGravity="start"
                app:tabBackground="@color/tab_bg"
                app:tabSelectedTextColor="@color/tab_selected_text"
                app:tabTextColor="@color/tab_unselected_text"
                app:tabIndicatorColor="@color/accent"
                app:tabIndicatorHeight="2dp"
                app:tabPaddingStart="0dp"
                app:tabPaddingEnd="0dp" />

            <ImageButton
                android:id="@+id/btnNewTab"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:src="@android:drawable/ic_input_add"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:tint="@color/accent"
                android:contentDescription="@string/content_desc_new_tab"
                android:layout_gravity="center_vertical" />

            <ImageButton
                android:id="@+id/btnZoomOut"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:padding="9dp"
                android:src="@drawable/ic_zoom_out"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:tint="#AAAAAA"
                android:contentDescription="@string/content_desc_zoom_out"
                android:layout_gravity="center_vertical" />

            <ImageButton
                android:id="@+id/btnZoomIn"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:padding="9dp"
                android:src="@drawable/ic_zoom_in"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:tint="#AAAAAA"
                android:contentDescription="@string/content_desc_zoom_in"
                android:layout_gravity="center_vertical" />

        </LinearLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Key rows under the terminal, drawn by Compose (ui/keybar/Keybar.kt) -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/keybar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>
