<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+). The saved connections are encrypted with a Keystore
  key, which is not backed up, so restored copies would be unusable. Some
  of the old store files are not encrypted at all, so all of them are left
  out.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/connections.pb" />
        <exclude domain="sharedpref" path="konsole_connections_box.xml" />
        <exclude domain="sharedpref" path="konsole_connections_enc.xml" />
        <exclude domain="sharedpref" path="konsole_connections.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/connections.pb" />
        <exclude domain="sharedpref" path="konsole_connections_box.xml" />
        <exclude domain="sharedpref" path="konsole_connections_enc.xml" />
        <exclude domain="sharedpref" path="konsole_connections.xml" />
    </device-transfer>
</data-extraction-rules>
